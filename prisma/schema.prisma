generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseType {
  ENTREE
  SORTIE
}

enum UserRole {
  PDG
  COMPTABLE
  DG
  DIRECTEUR_TECHNIQUE
  OBSERVATEUR
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  role      UserRole  @default(OBSERVATEUR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
  categories Category[]
}

model Category {
  id            String    @id @default(cuid())
  userId        String
  name          String
  monthlyBudget Decimal   @default(0) @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]

  @@unique([userId, name])
  @@index([userId, name])
}

model Expense {
  id           String      @id @default(cuid())
  userId       String?
  // La clé étrangère pour la relation
  categoryId   String?     
  
  title        String
  amount       Decimal     @db.Decimal(10, 2)
  type         ExpenseType
  
  // Ce champ stocke le nom en dur (pour l'historique)
  categoryName String?     
  
  isRecurring  Boolean     @default(false)
  expectedDate DateTime?
  spentAt      DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  // Relations
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, spentAt])
  @@index([categoryId, spentAt])
}